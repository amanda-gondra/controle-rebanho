# Normaliza quebra de linha para LF no repositório, independente do SO/editor
# que faz o checkout — evita que o Git marque o projeto inteiro como
# "modificado" só por causa de CRLF x LF (foi o que aconteceu antes deste
# arquivo existir).
* text=auto eol=lf

# Binários — nunca tocar em quebra de linha
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.svg text eol=lf
