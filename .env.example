# Variáveis de ambiente do backend. Copie para .env e preencha.
# NUNCA versione o .env real. Este arquivo só mostra os NOMES e o formato.
# A aplicação valida tudo ao subir (src/config/env.ts) e diz qual variável está errada.

# Obrigatória. Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5433/rebanho?schema=public"

# Banco SEPARADO só para os testes de integração. O nome tem que terminar em "_test";
# os testes apagam os dados dele a cada execução.
TEST_DATABASE_URL="postgresql://USUARIO:SENHA@localhost:5433/rebanho_test?schema=public"

# Opcionais (valor padrão entre parênteses)
# NODE_ENV=development          # development | test | production (development)
# HOST=127.0.0.1                # em hospedagem/container use 0.0.0.0 (127.0.0.1)
# PORT=3333                     # (3333)
# CORS_ORIGINS=http://localhost:5173   # origens do frontend, separadas por vírgula
# API_DOCS_ENABLED=true         # /docs; padrão: ligado, menos em produção
# LOG_LEVEL=info                # fatal | error | warn | info | debug | trace | silent
# RATE_LIMIT_MAX=100            # requisições por minuto por IP
# AUTH_RATE_LIMIT_MAX=10        # tentativas de entrar/criar conta por minuto por IP
# COOKIE_SECURE=true            # cookie de sessão só por HTTPS; padrão: ligado em produção

# Só para o comando de dados de exemplo (npx prisma db seed). Nunca use em produção.
# SEED_USER_EMAIL=voce@exemplo.com
# SEED_USER_PASSWORD=uma-senha-de-teste
