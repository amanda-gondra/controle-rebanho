new file mode 100644
index 0000000..695dd5e
--- /dev/null
+++ b/src/services/animal.service.ts
@@ -0,0 +1,50 @@
+import type { Category, Sex } from "@prisma/client";
+import { ErrorCode, ruleError } from "../lib/errors.js";
+import { isCategoryCompatible } from "../lib/categories.js";
+
+// Regras de categoria e castração do animal (G4 — RN-ANIMAL-004 e 006).
+// Função pura: recebe o animal atual (ou null no cadastro), o que mudou e o
+// padrão "castrado" da fazenda, e devolve o resultado final — ou lança o erro.
+
+type Profile = { sex: Sex; category: Category; castrated: boolean | null };
+
+type Changes = { sex?: Sex; category?: Category; castrated?: boolean };
+
+export function resolveAnimalProfile(
+  current: Profile | null,
+  changes: Changes,
+  defaultCastrated: boolean,
+): Profile {
+  const sex = changes.sex ?? current?.sex;
+  const category = changes.category ?? current?.category;
+  if (!sex || !category) {
+    // O schema de cadastro já exige os dois; aqui é só garantia de tipo.
+    throw new Error("Sexo e categoria são obrigatórios.");
+  }
+
+  if (!isCategoryCompatible(category, sex)) {
+    throw ruleError(
+      ErrorCode.CATEGORY_INCOMPATIBLE_WITH_SEX,
+      "Essa categoria não combina com o sexo escolhido.",
+      [{ field: "category", error: "Essa categoria não combina com o sexo escolhido." }],
+    );
+  }
+
+  // Fêmea: castrado não existe (fica vazio)
+  if (sex === "FEMALE") {
+    if (changes.castrated !== undefined) {
+      throw ruleError(ErrorCode.CASTRATED_ONLY_FOR_MALES, "Castrado só vale para machos.", [
+        { field: "castrated", error: "Castrado só vale para machos." },
+      ]);
+    }
+    return { sex, category, castrated: null };
+  }
+
+  // Macho: o que foi informado; senão mantém o que já tinha; senão o padrão da fazenda
+  const castrated =
+    changes.castrated ??
+    (current?.sex === "MALE" ? current.castrated : null) ??
+    defaultCastrated;
+
+  return { sex, category, castrated };
+}
diff --git a/tests/integration/categories.test.ts b/tests/integration/categories.test.ts
new file mode 100644
index 0000000..32dff29
--- /dev/null
+++ b/tests/integration/categories.test.ts
@@ -0,0 +1,190 @@
+import { describe, expect, it } from "vitest";
+import { useTestApp } from "../helpers/suite.js";
+import { createAnimal } from "../helpers/factories.js";
+import { prisma } from "../../src/lib/prisma.js";
+import { DEFAULT_CATEGORY_LABELS } from "../../src/lib/categories.js";
+
+// CATEGORIAS (G4 — D-02, RN-ANIMAL-004/006/007). Critérios do Escopo §7 e da
+// "Espec — Animais" (números entre parênteses).
+
+const t = useTestApp();
+
+const postAnimal = (payload: Record<string, unknown>) =>
+  t.client.inject({
+    method: "POST",
+    url: "/animals",
+    payload: { tag: `C-${Math.random().toString(36).slice(2, 8)}`, ...payload },
+  });
+
+const putAnimal = (id: string, payload: Record<string, unknown>) =>
+  t.client.inject({ method: "PUT", url: `/animals/${id}`, payload });
+
+const patchFarm = (payload: Record<string, unknown>) =>
+  t.client.inject({ method: "PATCH", url: "/farm", payload });
+
+describe("categoria × sexo no cadastro (Escopo G4, critério 1 · Espec critério 4)", () => {
+  it.each([
+    ["MALE", "CALF"],
+    ["FEMALE", "CALF"],
+    ["FEMALE", "HEIFER"],
+    ["FEMALE", "COW"],
+    ["MALE", "YEARLING"],
+    ["MALE", "ADULT_MALE"],
+    ["MALE", "BULL"],
+  ])("%s + %s é aceito", async (sex, category) => {
+    const response = await postAnimal({ sex, category });
+    expect(response.statusCode).toBe(201);
+    expect(response.json()).toMatchObject({ sex, category });
+  });
+
+  it.each([
+    ["FEMALE", "YEARLING"],
+    ["FEMALE", "ADULT_MALE"],
+    ["FEMALE", "BULL"],
+    ["MALE", "HEIFER"],
+    ["MALE", "COW"],
+  ])("%s + %s é recusado e nada é gravado", async (sex, category) => {
+    const response = await postAnimal({ sex, category });
+    expect(response.statusCode).toBe(400);
+    expect(response.json().code).toBe("CATEGORY_INCOMPATIBLE_WITH_SEX");
+    expect(response.json().errors).toEqual([expect.objectContaining({ field: "category" })]);
+    expect(await prisma.animal.count({ where: { farmId: t.client.farm.id } })).toBe(0);
+  });
+
+  it("categorias antigas não existem mais", async () => {
+    const response = await postAnimal({ sex: "MALE", category: "STEER" });
+    expect(response.statusCode).toBe(400);
+    expect(response.json().code).toBe("VALIDATION_ERROR");
+  });
+
+  it("o banco também recusa a combinação errada (defesa extra)", async () => {
+    await expect(
+      prisma.animal.create({
+        data: { farmId: t.client.farm.id, tag: "DB-1", sex: "FEMALE", category: "BULL" },
+      }),
+    ).rejects.toThrow();
+  });
+});
+
+describe("castrado (RN-ANIMAL-006)", () => {
+  it("macho sem castrado informado usa o padrão da fazenda (não)", async () => {
+    const response = await postAnimal({ sex: "MALE", category: "YEARLING" });
+    expect(response.json().castrated).toBe(false);
+  });
+
+  it("com o padrão da fazenda = sim, macho novo vem castrado", async () => {
+    await patchFarm({ defaultCastrated: true });
+    const response = await postAnimal({ sex: "MALE", category: "ADULT_MALE" });
+    expect(response.json().castrated).toBe(true);
+  });
+
+  it("o informado vale mais que o padrão", async () => {
+    await patchFarm({ defaultCastrated: true });
+    const response = await postAnimal({ sex: "MALE", category: "BULL", castrated: false });
+    expect(response.json().castrated).toBe(false);
+  });
+
